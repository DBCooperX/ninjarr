# ninjarr — copy to .env, or just run ./bootstrap.sh and it will ask
# Never commit .env.

# Run: stat -c '%u:%g' /path/to/media   — on Synology this is often 1024:100
PUID=1000
PGID=1000

TZ=Europe/Zurich

# Completed downloads, pre-import — always local, fast disk.
DOWNLOADS=/data/downloads

# Your media library — what Plex/Emby/Jellyfin actually reads. A path on this
# VM, or an already-mounted NAS share (bootstrap doesn't mount NAS shares for
# you). Ideally the same filesystem as DOWNLOADS so imports hardlink instead
# of copying — bootstrap checks this for you and tells you which mode you're in.
MEDIA=/data/media

APPDATA=/opt/appdata

# Unpack scratch — fast LOCAL disk, never the NAS.
INCOMPLETE=/opt/incomplete
