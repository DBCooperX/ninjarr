# Image versions this ninjarr release was tested with. bootstrap.sh uses exactly these, so a
# rebuild from ninjarr.env gives the same apps, not whatever is newest that day.
# They move forward with ninjarr releases: git pull, then ./bootstrap.sh update.
# To run something newer yourself, set the same key in ninjarr.env (e.g. SONARR_TAG='latest').
# Never go back to an older version over existing data: the apps upgrade their databases on
# start and can't read them with an older release. Restore a backup instead.
AIOSTREAMS_TAG='v2.36.0'
PROWLARR_TAG='2.6.5.5623-ls165'
SONARR_TAG='4.0.20.3014-ls1'
RADARR_TAG='6.4.4.10685-ls323'
BAZARR_TAG='v1.6.2-ls369'
EMBY_TAG='4.10.2.0-ls303'
SEERR_TAG='v3.5.1'
DISPATCHARR_TAG='0.32.0'
CADDY_TAG='2-alpine'
