{
  "name": "Dojo · ninjarr",
  "short_name": "Dojo",
  "description": "ninjarr's control panel: health, now playing, stats, the library, settings, backups",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c0a09",
  "theme_color": "#0c0a09",
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Stats", "url": "/#stats", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Library", "url": "/#library", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "url": "/#settings", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "System", "url": "/#system", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] }
  ]
}
