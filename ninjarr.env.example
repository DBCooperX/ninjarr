# ninjarr.env — everything ninjarr needs to build the stack without asking.
#
# You normally don't write this by hand: ./bootstrap.sh asks a few questions on the first run
# and writes it for you, including generated keys. Fill it in yourself only to build fully
# unattended, e.g. with proxmox/create-vm.sh --env ninjarr.env.
#
# Rules: every value in single quotes; no single quote (') inside a value. Never commit this file.

# ── basics
TZ='Etc/UTC'                         # your timezone, e.g. Europe/Berlin or America/New_York
NINJARR_DATA='/opt/ninjarr'          # app configs + the (tiny, symlink-only) library live here
PUID='1000'                           # user/group the apps run as
PGID='1000'

# ── one login for everything (Emby, Seerr, Sonarr, Radarr, Prowlarr, Bazarr, AIOStreams)
ADMIN_USER='admin'
ADMIN_PASSWORD='change-me-please'     # 8+ characters; no ' or , in it

# ── usenet provider(s) — a JSON list. isBackup=true: only asked for articles the others miss
USENET_PROVIDERS='[{"id":"p1","name":"Easynews","host":"news.easynews.com","port":563,"tls":true,"username":"you","password":"secret","maxConnections":20,"priority":0,"isBackup":false,"enabled":true}]'

# ── Newznab indexers for Prowlarr — a JSON list; may be [] and added in Prowlarr later
INDEXERS='[{"name":"My Indexer","url":"https://indexer.example.com","apikey":"your-key"}]'

# ── audio language
PREFERRED_LANGUAGE='German'           # English name as Sonarr knows it, or 'none'
REQUIRE_LANGUAGE='no'                 # 'yes' = never grab a release without it
LANGUAGE_WAIT_MINUTES='0'             # wait this long for it before taking another language

# ── subtitles (optional): Podnapisi and Gestdown are on without an account. An OpenSubtitles.com
# login adds the biggest catalogue (free accounts get about 20 downloads a day).
OPENSUBTITLES_USER=''
OPENSUBTITLES_PASS=''

# ── live TV (optional): Dispatcharr turns an IPTV subscription into channels + guide in Emby.
# Watching Live TV in Emby needs Emby Premiere. You pick the channels in Dispatcharr (port 9191).
IPTV='no'                             # 'yes' to install Dispatcharr
IPTV_TYPE=''                          # 'xtream' (server + login), 'm3u' (playlist link), or '' to add it in Dispatcharr
IPTV_URL=''                           # Xtream server URL (http://provider.example:8080) or the M3U playlist URL
IPTV_USER=''                          # Xtream only
IPTV_PASS=''                          # Xtream only
IPTV_EPG_URL=''                       # XMLTV guide URL; Xtream logins get theirs automatically
IPTV_MAX_STREAMS='1'                  # channels that may play at once (your plan's connection limit)

# ── remote access (optional): HTTPS via Caddy for emby./request./stream.<DOMAIN>
DOMAIN=''
ACME_EMAIL=''
DOJO_HTTPS='no'                       # 'yes': Dojo at https://dojo.<DOMAIN> too, for home-network devices only

# ── backups: nightly at ~04:30. They sit on this VM's disk, so also copy them somewhere else
# (or point BACKUP_DIR at a network share). ./bootstrap.sh restore <file> rebuilds from one.
# BACKUP_DIR='/opt/ninjarr/backups'
# BACKUP_KEEP='7'

# ── notifications and restarts (optional)
DISCORD_WEBHOOK=''                    # a Discord message on grabs, imports and problems
AUTO_REBOOT='no'                      # 'yes': restart at about 04:45 when a security update needs it

# Memory ceiling per app (defaults in compose/stack.yml); raise one if Dojo says it keeps hitting it
# EMBY_MEM='6g'  AIOSTREAMS_MEM='4g'  DISPATCHARR_MEM='4g'  SONARR_MEM='2g'  RADARR_MEM='2g'  SEERR_MEM='2g'
# BAZARR_MEM='2g'  PROWLARR_MEM='1g'  DOJO_MEM='1g'  CADDY_MEM='512m'
# BACKUP_SCHEDULE='daily'             # 'off' to switch the nightly backup off

# ── generated on the first run if missing — keep them to get identical apps after a rebuild
# SONARR_API_KEY=''
# RADARR_API_KEY=''
# PROWLARR_API_KEY=''
# ARR_CLIENT_PASSWORD=''
# AIOSTREAMS_SECRET_KEY=''           # can't change after AIOStreams' first start
# EMBY_API_KEY=''
# BAZARR_API_KEY=''
